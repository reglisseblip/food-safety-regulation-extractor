# API keys for the AgentReg project — copy this file to `.env` and fill in the key(s) you use.
# The DEFAULT provider is openai (model gpt-5-mini): fill in OPENAI_API_KEY to run the
# README examples as-is.
# For another provider: `agentreg run ... --provider claude --model claude-sonnet-4-6`.

# OpenAI (default) — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic OFFICIAL (Claude models: claude-sonnet-4-6, claude-sonnet-5, claude-haiku-4-5…)
# — https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenRouter (multi-model, used by the benchmark --compare sweep) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Ollama Cloud (hosted open-source models) — https://ollama.com
OLLAMA_API_KEY=
